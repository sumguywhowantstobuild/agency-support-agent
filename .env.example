# Copy to .env and fill in. Never commit .env.

# Required: the agent will not start if any of these is missing or empty.
OPENAI_API_KEY=
OPENAI_MODEL=
DATABASE_URL=
AGENT_API_KEY=
# The key pair that locks each client's HighLevel key (entered in the admin app, stored locked in the database).
# Make with the openssl line in SETUP section 14. The agent gets only the private half and is the only part
# that can open a key; the admin app gets only the public half. Keep both in the password manager's copy of .env:
# losing the private half means entering every client key again.
GHL_KEY_PRIVATE=
GHL_KEY_PUBLIC=

# Optional: defaults shown. Uncomment only to change.
# EMBEDDING_MODEL=text-embedding-3-small
# TOOL_CALL_CAP=8
# AGENT_TIME_BUDGET=75
# MAX_CONCURRENT_DRAFTS=8
# MAX_TICKET_CHARS=8000
# SEARCH_TOP_K=5
# SEARCH_MAX_PER_DOC=2
# GHL_MCP_URL=https://services.leadconnectorhq.com/mcp/openai/v2/

# Accuracy test only (evals): the model that grades the drafts. No default: it must differ from OPENAI_MODEL, so a
# cheaper agent model can't make grading easier. The live agent never reads it.
# JUDGE_MODEL=

# The database admin password (PC and server), used for setup, migrations and restores, never by the agent.
POSTGRES_PASSWORD=

# The agent's read-only database login (migration 003). Make with: openssl rand -hex 32
# DATABASE_URL above uses it: postgresql://agent_reader:<this password>@127.0.0.1:5433/knowledge
AGENT_DB_PASSWORD=

# n8n (PC and server). Make each with: openssl rand -hex 32
N8N_DB_PASSWORD=
# Encrypts the logins saved in n8n. Keep a copy in your password manager.
N8N_ENCRYPTION_KEY=

# Login n8n's knowledge sync uses for the knowledge database. Make with: openssl rand -hex 32
KB_SYNC_DB_PASSWORD=
# Login n8n's ticket workflows use (intake, approval, clean-up; migration 004). Make with: openssl rand -hex 32
N8N_SUPPORT_DB_PASSWORD=

# The tunnel (PC and server): Slack reaches n8n's webhooks through Cloudflare. Treat the token like a password.
# Token: Cloudflare -> Networking -> Tunnels -> your tunnel -> its install command (the part after --token).
# A staged server (deploy/restore.sh staged) never starts the tunnel; until it has its own, any non-empty placeholder.
CLOUDFLARE_TUNNEL_TOKEN=
# The public address n8n shows for its webhooks: the tunnel's hostname, ending in /
N8N_WEBHOOK_URL=https://n8n-dev.<your domain>/

# Nightly backups: the backup login (migration 010). Make with: openssl rand -hex 32
BACKUP_DB_PASSWORD=
# Cloudflare R2: bucket with a 14-day lock rule and a 15-day delete rule; an Account API token with Object Read &
# Write on that bucket only. Endpoint = the bucket's "S3 API" address without the bucket name at the end.
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_ENDPOINT=https://<account id>.r2.cloudflarestorage.com
R2_BUCKET=bluejay-backups
# The public half of the backup key pair (starts with age1). The private half lives only in your password manager.
BACKUP_AGE_RECIPIENT=

# The admin app (SETUP section 14). Its database login (migration 017), functions only. Make with: openssl rand -hex 32
ADMIN_DB_PASSWORD=
# The Cloudflare Access gate in front of it: the Zero Trust team domain and the Access application's audience tag.
CF_TEAM_DOMAIN=<team>.cloudflareaccess.com
CF_AUDIENCE=
# The admin app's own address, with no / at the end: every form must come from it.
ADMIN_ORIGIN=https://admin.<your domain>
# The agency's time zone (an IANA name, e.g. America/New_York): "today" on the Clients chart starts at its midnight and
# History shows its times. Left out, it is America/New_York. A name that isn't one stops the admin app at start.
TIME_ZONE=America/New_York
# The Slack bot's token (xoxb-...): Add client lists the private channels the bot is in.
SLACK_BOT_TOKEN=
